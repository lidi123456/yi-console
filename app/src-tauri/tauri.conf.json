{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yi Console",
  "version": "0.1.0",
  "identifier": "dev.yiconsole.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Yi Console",
        "width": 1320,
        "height": 800,
        "center": true,
        "minWidth": 360,
        "minHeight": 480,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/yi-agentd"
    ],
    "resources": {
      "resources/yi-agentd/": "yi-agentd-dist/"
    },
    "category": "DeveloperTool",
    "shortDescription": "Use and manage all your AI coding tools in one place"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEQUIyQjE5OTY3RjVBQTYKUldTbVduK1dHU3VyN2I2b1Y5OFcwaGJLQnpnVkJxNkd5RFZRdlh1ZjJJdjNoeW9zNHFFZCthZHgK",
      "endpoints": [
        "https://github.com/lidi123456/yi-console/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
