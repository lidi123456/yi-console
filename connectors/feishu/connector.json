{
  "id": "feishu",
  "version": "0.1.0",
  "api": "0.1",
  "runtime": "wasm",
  "main": "connector.wasm",
  "name": { "zh": "飞书", "en": "Feishu / Lark" },
  "description": {
    "zh": "通过长连接接收飞书机器人的群聊和私聊消息，Bot 可以回复到原会话，也可以把提醒发到指定的群",
    "en": "Receives Feishu / Lark bot messages from group and private chats over the long connection; the Bot replies in the chat and can send reminders to a chosen chat"
  },
  "capabilities": ["trigger", "reply", "context", "notify"],
  "permissions": { "net": ["open.feishu.cn", "*.feishu.cn", "open.larksuite.com", "*.larksuite.com"], "exec": [] },
  "config": {
    "type": "object",
    "required": ["appId", "appSecret"],
    "properties": {
      "appId": { "type": "string", "title": "App ID" },
      "appSecret": { "type": "string", "title": "App Secret", "x-secret": true },
      "domain": {
        "type": "string",
        "enum": ["feishu", "lark"],
        "default": "feishu",
        "title": "版本",
        "x-labels": { "feishu": "飞书", "lark": "Lark" },
        "x-en": { "title": "Edition", "x-labels": { "feishu": "Feishu", "lark": "Lark" } }
      },
      "listen": {
        "type": "string",
        "enum": ["mentions", "all"],
        "default": "mentions",
        "title": "群聊里收哪些消息",
        "x-labels": { "mentions": "只收 @ 机器人的", "all": "全部（未 @ 的作为旁听）" },
        "x-en": { "title": "Group messages to take", "x-labels": { "mentions": "Only those that @ the bot", "all": "All (the rest as ambient)" } }
      },
      "notifyChat": {
        "type": "string",
        "title": "提醒发到哪个会话",
        "description": "chat_id（oc_ 开头）；用作 Bot 的提醒渠道时需要",
        "x-en": { "title": "Reminder chat", "description": "chat_id (starts with oc_); needed when the Bot sends reminders here" }
      }
    }
  }
}
